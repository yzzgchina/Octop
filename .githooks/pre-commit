#!/usr/bin/env bash
# Pre-commit gate: make precommit (format BE+FE + lint + lint-frontend + typecheck +
# testmon-scoped backend tests + the **full** frontend suite) + dashboard build. CI runs
# those same legs unscoped and read-only (make lint / lint-frontend / typecheck / test /
# test-frontend); this is a fast, change-aware local gate so commits don't wait on the
# whole backend test matrix.
# The frontend leg is deliberately unscoped (P1-9): the dashboard has no change-aware
# runner here, so a red vitest suite blocks the commit instead of only warning.
# Enable once per clone:  make install-hooks
# Bypass (emergency only): SKIP_PRECOMMIT=1 git commit ...
# Or: git commit --no-verify
set -euo pipefail

if [[ "${SKIP_PRECOMMIT:-}" == "1" ]]; then
  echo "[pre-commit] SKIP_PRECOMMIT=1 — skipping checks"
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Remember staged paths so we can re-add them after auto-format rewrites the worktree.
# Portable (bash 3.2+): avoid `mapfile` (bash 4+ only).
STAGED_FILES=()
while IFS= read -r line; do
  [[ -n "$line" ]] && STAGED_FILES+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR || true)

echo "[pre-commit] make precommit  (format-all + lint + lint-frontend + typecheck + testmon-scoped test + full frontend suite)"
make precommit

# If format rewrote files that were already staged, refresh the index so the
# commit includes the formatted content (worktree vs index drift).
if ((${#STAGED_FILES[@]} > 0)); then
  existing=()
  for f in "${STAGED_FILES[@]}"; do
    if [[ -e "$f" || -L "$f" ]]; then
      existing+=("$f")
    fi
  done
  if ((${#existing[@]} > 0)); then
    git add -- "${existing[@]}"
  fi
fi

echo "[pre-commit] dashboard npm run build"
(
  cd "$ROOT/dashboard"
  npm run build
)

echo "[pre-commit] all checks passed"
